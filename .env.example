# ============================================
# EduPiFlow — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to GitHub.

# --- Pi Network Configuration ---
PI_API_KEY=your_pi_api_key_here
PI_APP_ID=your_pi_app_id_here
PI_SANDBOX=true
PI_NETWORK=testnet

# --- Backend Server ---
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/edupiflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edupiflow
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Exchange Rate (BNR) ---
BNR_API_URL=https://www.bnr.rw/api/exchange-rates
BNR_FALLBACK_RWF_PER_USD=1300
EXCHANGE_RATE_CACHE_MINUTES=60

# --- GCV Standard ---
GCV_PI_TO_USD=314159
MICRO_PI_PER_PI=1000000

# --- JWT Secret ---
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# --- Escrow ---
ESCROW_HOURS=48
ESCROW_WALLET_ADDRESS=your_escrow_pi_wallet_address

# --- Notification ---
NOTIFICATION_ENABLED=true
